# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file anywhere public.

# Google AI Studio -> https://aistudio.google.com/app/apikey (free)
GEMINI_API_KEY=

# NVIDIA NIM -> https://build.nvidia.com/ (used as LLM fallback)
NVIDIA_API_KEY=

# Fish Audio TTS -> https://fish.audio/
FISH_API_KEY=

# Reddit app -> https://www.reddit.com/prefs/apps  (create a "script" type app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=youtube-factory-bot/0.1 by yourredditusername

# YouTube OAuth client file (downloaded from Google Cloud Console) should be saved as:
#   config/client_secret.json
# No key needed here - it authenticates via a browser popup on first run.

# Email Alert Configuration (For Daemon Crash Notifications)
# Create an App Password in your Google Account security settings.
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
